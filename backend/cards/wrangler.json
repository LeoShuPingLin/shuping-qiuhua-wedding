{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "wedding-thank-you-cards",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_LIMITER",
        "class_name": "UsageLimiter"
      }
    ]
  },
  "exports": {
    "UsageLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://leoshupinglin.github.io",
    "CARD_TOTAL_LIMIT": "500",
    "CARD_DAILY_LIMIT": "500"
  }
}
