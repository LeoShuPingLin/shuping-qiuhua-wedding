{
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background_color": "#F7F3EE"
  },
  "background": {
    "top_image": "assets/background_top.jpg",
    "bottom_image": "assets/background_bottom.jpg",
    "top_height": 280,
    "bottom_height": 280,
    "blur_radius": 1.2,
    "brightness": 0.88
  },
  "carousel": {
    "photos_dir": "photos",
    "direction": "left",
    "speed_px_per_second": 72,
    "photo_height": 390,
    "gap": 28,
    "vertical_offset": 0,
    "frame_padding": 12,
    "frame_color": "#FFFFFF",
    "corner_radius": 20,
    "shadow_blur": 16,
    "shadow_offset_y": 8,
    "shadow_opacity": 78,
    "loop_cycles": 1
  },
  "output": {
    "video_file": "output/wedding_slideshow.mp4",
    "preview_file": "output/preview.png",
    "preview_second": 2,
    "crf": 18,
    "preset": "medium"
  }
}
